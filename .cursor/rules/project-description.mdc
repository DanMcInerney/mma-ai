# Project Description Rule
# This rule defines the core structure and conventions of the UFC fight prediction project

LANGUAGE: Python
FRAMEWORK: AutoGluon
DATABASE: PostgreSQL

GOAL:
  - An autogluon model that accurately predicts UFC fights
  - Uses a database of stats which are created from a starting competitions.csv and fighters.csv stats
  - Calculators are run to engineer more stats from those csvs and put into the database.

STARTING DATA:
  - The initial data comes from competitions.csv and individuals.csv and is built upon.

TESTS:
  - tests are located in tests\ folder.

# Schema Organization
SCHEMAS:
  - features:     # Primary data storage

# Core Tables
TABLES:
  fighter_mapping:
    primary_key: fighter_id
    naming: lowercase
    indexes: [fighter_id, fighter_url]

  event_mapping:
    primary_key: event_id
    indexes: [event_id, event_date]

  fight_mapping:
    primary_key: fight_id
    foreign_keys: [event_id, fighter1_id, fighter2_id]
    unique: [event_id, fighter1_id, fighter2_id]

# Feature Conventions
BASE_FEATURES: [
  'age', 'days_since_last_fight', 'reach', 'ape',
  'strikes', 'sig_str', 'head', 'body', 'leg', 'distance',
  'clinch', 'ground', 'td', 'sub', 'ko', 'kd', 'decision', 'ctrl', 'win', 'ufcage'
]

TABLES:
These tables hold all the stat data like features.sig_str will contain, for example, columns like sig_str_acc, sig_str_land, sig_str_ratio
  - features.<stat>
  - features.<stat>_rd1

STAT_SUFFIXES:
  _att: "attempts"
  _land: "landed successfully"
  _def: "defense ratio (0-1)"
  _acc: "accuracy ratio (0-1)"
  _ratio: "fighter1/(fighter1 + fighter2)"
  _opp: "opponent's stat"
  _opp_avg: "average of opponents' performance vs fighter"
  _opp_sdev: "std dev of opponents' performance"
  _avg: "career average"
  _sdev: "career standard deviation"
  _dec: "time-decay weighted (1.5yr half-life)"
  _slope: "historical trend"
  _adjperf: "(fighter1_stat - fighter2_stat_opp_avg) / fighter2_stat_opp_sdev"

# Special Rules
RULES:
  - All fighter names must be lowercase
  - Each base feature requires both main and round1 tables
  - Time decay calculations use 1.5-year half-life
  - Adjusted performance uses opponent-normalized calculations 